{
    "name": "donaco",
    "version": "1.0.9",
    "description": "Support DolphinDB language in Monaco Editor (syntax highlight, completions, docs)",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vscode": {
            "types": "./dist/vscode.d.ts",
            "import": "./dist/vscode.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./theme/*": {
            "types": "./dist/theme/*.d.ts",
            "import": "./dist/theme/*.js"
        }
    },
    "files": [
        "./dist/",
        "./src/"
    ],
    "scripts": {
        "dev": "node ./copy.ts && cd example && vite",
        "build": "tsc"
    },
    "license": "Apache-2.0",
    "author": "DolphinDB",
    "homepage": "https://github.com/dolphindb/donaco",
    "repository": {
        "type": "git",
        "url": "https://github.com/dolphindb/donaco.git"
    },
    "keywords": [
        "monaco",
        "monaco-editor",
        "dolphindb",
        "language"
    ],
    "devDependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@types/node": "^20.19.25",
        "@types/react": "^19.2.4",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "dolphindb": "^3.1.24",
        "eslint": "^9.39.1",
        "monaco-editor": "0.52.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^5.9.3",
        "vite": "^7.2.2",
        "vite-plugin-monaco-editor": "^1.1.0",
        "vite-plugin-pages": "^0.33.1",
        "vite-tsconfig-paths": "^5.1.4",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.2.1",
        "xshell": "^1.3.6"
    },
    "peerDependencies": {
        "dolphindb": "^3.0.35",
        "monaco-editor": ">=0.47.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.0.0"
    },
    "optionalDependencies": {
        "@monaco-editor/react": "^4.7.0"
    }
}
