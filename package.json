{
    "name": "monaco-dolphindb",
    "version": "1.0.5",
    "description": "Support DolphinDB language in Monaco Editor (syntax highlight, completions, docs)",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vscode": {
            "types": "./dist/vscode.d.ts",
            "import": "./dist/vscode.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./theme/*": {
            "types": "./dist/theme/*.d.ts",
            "import": "./dist/theme/*.js"
        }
    },
    "files": [
        "./dist/",
        "./src/"
    ],
    "scripts": {
        "dev": "node ./copy.ts && cd example && vite",
        "build": "tsc"
    },
    "license": "Apache-2.0",
    "author": "DolphinDB",
    "homepage": "https://github.com/dolphindb/monaco-dolphindb",
    "repository": {
        "type": "git",
        "url": "https://github.com/dolphindb/monaco-dolphindb.git"
    },
    "keywords": [
        "monaco",
        "monaco-editor",
        "dolphindb",
        "language"
    ],
    "devDependencies": {
        "@monaco-editor/react": "^4.6.0",
        "@types/node": "^22.13.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "dolphindb": "^3.0.217",
        "eslint": "^9.20.1",
        "monaco-editor": "^0.52.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "vite-plugin-monaco-editor": "^1.1.0",
        "vite-plugin-pages": "^0.32.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.2.0",
        "xshell": "^1.2.14"
    },
    "peerDependencies": {
        "dolphindb": "^3.0.35",
        "monaco-editor": ">=0.47.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.0.0"
    },
    "optionalDependencies": {
        "@monaco-editor/react": "^4.6.0"
    }
}
